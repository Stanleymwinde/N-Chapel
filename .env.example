# Craft CMS (headless). Leave CRAFT_GRAPHQL_URL empty to use only the typed files in /content.
CRAFT_GRAPHQL_URL=https://cms.nairobichapelngongroad.org/api
# Only needed if the CMS's public GraphQL schema is switched off
CRAFT_GRAPHQL_TOKEN=
# How often (seconds) pages re-check Craft for changes
CRAFT_REVALIDATE=300
# Secret for instant refresh: Craft calls /api/revalidate?secret=... when content is saved
CRAFT_REVALIDATE_SECRET=
# Local CMS copy only: allow its images, e.g. "localhost"
CRAFT_ASSETS_HOST=
